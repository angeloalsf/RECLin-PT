# --- Dados: corpus restrito e derivados diretos ---
# SemClinBr tem licenca restrita: NUNCA versionar.
SemClinBr-xml-public-v1/
data/processed/
codigo/dados/brutos/
codigo/dados/processados/
# NOTA: codigo/dados/particoes/ E versionado de proposito (congela o test entre
# os modelos; conferido pelo SHA-256 do MANIFEST.json).

# --- Modelos e checkpoints (centenas de MB) ---
checkpoints/
best_model/
last_checkpoint/
*.pt
*.pth
*.bin
*.safetensors
# Excecao: o modelo minusculo das referencias de validacao (~60 KB) e versionado.
!codigo/testes/referencia/modelo_minusculo/*.safetensors
# Pesos pre-treinados baixados num commit exato (scripts/pretreino.py baixar);
# a revisao fica registrada no config.json de cada execucao.
codigo/modelos_pretreinados/

# --- Logs ---
logs/
*.log

# --- Notebooks ---
.ipynb_checkpoints/

# --- LaTeX (artefatos de compilacao; artigo.bbl E versionado) ---
*.aux
*.blg
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# --- SO e editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# NOTA: os resultados (codigo/resultados/, quando existirem) NAO sao ignorados.
